{
  "name": "@runforyou/jetcast",
  "version": "0.1.0",
  "description": "Laravel Echo style client for jetcast: receive server-broadcast events over NATS WebSocket.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runforyou-ai/jetcast.git",
    "directory": "js"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "nats",
    "websocket",
    "broadcasting",
    "echo",
    "realtime"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@nats-io/nats-core": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
